{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shift-diary",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-diary",
      // Created with `wrangler d1 create shift-diary`. The id is an identifier, not a secret.
      "database_id": "c1d9aa84-6fc0-49f6-b1d0-b7becf1857f7",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true }
  // VERSION / COMMIT are injected at deploy time: wrangler deploy --var VERSION:... --var COMMIT:...
}
