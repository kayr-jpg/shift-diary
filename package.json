{
  "name": "shift-diary",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @shift/api --filter @shift/web run dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present --filter \"!@shift/e2e\" test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter @shift/e2e test",
    "smoke": "test -n \"$BASE_URL\" || { echo 'pnpm smoke: BASE_URL is not set (e.g. BASE_URL=https://shift-diary.<account>.workers.dev pnpm smoke)' >&2; exit 1; } && pnpm --filter @shift/e2e exec playwright test smoke --project=desktop",
    "demo:record": "pnpm --filter @shift/e2e demo:record",
    "video:proof": "pnpm --filter @shift/video proof",
    "video:studio": "pnpm --filter @shift/video studio",
    "video:render": "pnpm --filter @shift/video render"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
